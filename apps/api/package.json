{
  "name": "@ob-cms/api",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "nest start --watch -b swc",
    "build": "nest build",
    "start": "node dist/main",
    "start:prod": "node dist/main",
    "type-check": "tsc --noEmit",
    "lint": "eslint src",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/database/migrate.ts",
    "db:seed": "tsx src/database/seed/seed.ts",
    "db:seed:reusable-blocks": "tsx src/database/seed/seed-officebeacon-reusable-blocks.ts",
    "test:e2e": "vitest run --config vitest.config.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.840.0",
    "@aws-sdk/s3-request-presigner": "3.840.0",
    "@nestjs/bullmq": "11.0.4",
    "@nestjs/common": "11.1.28",
    "@nestjs/core": "11.1.28",
    "@nestjs/platform-express": "11.1.28",
    "@nestjs/swagger": "11.0.3",
    "@ob-cms/block-schema": "workspace:*",
    "@ob-cms/config": "workspace:*",
    "@ob-cms/shared": "workspace:*",
    "@ob-cms/template-registry": "workspace:*",
    "@thi.ng/ksuid": "3.2.125",
    "bcryptjs": "2.4.3",
    "bullmq": "5.34.10",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.1",
    "cookie-parser": "1.4.7",
    "dotenv": "16.4.7",
    "drizzle-orm": "0.45.2",
    "express": "4.21.2",
    "helmet": "8.0.0",
    "http-status-codes": "2.3.0",
    "ioredis": "5.4.2",
    "jsonwebtoken": "9.0.2",
    "nodemailer": "9.1.1",
    "pg": "8.13.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.1",
    "@ob-cms/crypto": "workspace:*",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.0",
    "@nestjs/schematics": "11.0.0",
    "@nestjs/testing": "11.1.28",
    "@swc/cli": "0.5.2",
    "@swc/core": "1.10.7",
    "@types/bcryptjs": "2.4.6",
    "@types/cookie-parser": "1.4.8",
    "@types/express": "5.0.0",
    "@types/jsonwebtoken": "9.0.7",
    "@types/node": "24.13.2",
    "@types/nodemailer": "6.4.17",
    "@types/pg": "8.11.10",
    "@types/supertest": "6.0.2",
    "drizzle-kit": "0.30.1",
    "supertest": "7.0.0",
    "tsx": "4.19.2",
    "typescript": "5.7.3",
    "unplugin-swc": "1.5.1",
    "vite-tsconfig-paths": "5.1.4",
    "vitest": "3.2.7"
  }
