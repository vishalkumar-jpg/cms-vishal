# ─────────────────────────────────────────────────────────────
# OB-CMS — local environment. Copy to `.env` and adjust.
# ─────────────────────────────────────────────────────────────
ENVIRONMENT=local

# ── API ──
API_PORT=3001
WORKER_PORT=3011
GLOBAL_PREFIX=api/v1
ALLOWED_ORIGINS=http://localhost:5001,http://localhost:3000

# ── Database (Postgres 16) ──
# Host port is 5433 (mapped to container 5432) to avoid clashing with a host Postgres on 5432.
DATABASE_URL=postgresql://obcms:obcms@localhost:5433/obcms
DATABASE_SSL=false
DATABASE_HOST=localhost
DATABASE_PORT=5433
DATABASE_USER=obcms
DATABASE_PASSWORD=obcms
DATABASE_NAME=obcms

# ── Redis 7 (cache + BullMQ) ──
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ── Auth (local JWT now; Auth0 adapter flagged off — TODO W1) ──
JWT_SECRET=change-me-in-production
# C21: short-lived access token; refresh-on-401 keeps sessions alive.
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=7d
COOKIE_DOMAIN=localhost
AUTH0_ENABLED=false

# ── Rate limiting (WAVE4b) — Redis fixed-window, fail-open ──
# Set RATE_LIMIT_ENABLED=false to disable enforcement (e.g. load tests).
RATE_LIMIT_ENABLED=true
RATE_LIMIT_GLOBAL_WINDOW=60
RATE_LIMIT_GLOBAL_MAX=300
RATE_LIMIT_AUTH_WINDOW=60
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_FORM_WINDOW=60
RATE_LIMIT_FORM_MAX=10
RATE_LIMIT_AI_WINDOW=60
RATE_LIMIT_AI_MAX=5
RATE_LIMIT_AI_MONTHLY_MAX=500

# ── Object storage (media, form uploads, backups) ──
# Legacy S3_* aliases remain fully supported. Provider-neutral OBJECT_STORAGE_*
# variables take precedence when set. See docs/architecture/platform-deployment.md.
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=ob-cms-media
# S3_PUBLIC_URL=
#
# Optional provider-neutral equivalents (uncomment to prefer over S3_*):
# OBJECT_STORAGE_PROVIDER=s3          # s3 | minio | r2
# OBJECT_STORAGE_MODE=shared          # shared | isolated
# OBJECT_STORAGE_ENDPOINT=http://localhost:9000
# OBJECT_STORAGE_REGION=us-east-1
# OBJECT_STORAGE_ACCESS_KEY_ID=minioadmin
# OBJECT_STORAGE_SECRET_ACCESS_KEY=minioadmin
# OBJECT_STORAGE_BUCKET=ob-cms-media
# OBJECT_STORAGE_PUBLIC_MEDIA_URL=
# Isolated mode only (requires OBJECT_STORAGE_MODE=isolated):
# OBJECT_STORAGE_PUBLIC_MEDIA_BUCKET=
# OBJECT_STORAGE_PRIVATE_FORM_ATTACHMENTS_BUCKET=
# OBJECT_STORAGE_PRIVATE_BACKUPS_BUCKET=
#
# Optional edge selection (config only in PR 1 — no Cloudflare network calls):
# EDGE_PROVIDER=none                  # none | cloudfront | cloudflare
# CLOUDFLARE_PURGE_ENABLED=false
# CLOUDFLARE_CUSTOM_HOSTNAMES_ENABLED=false
# CLOUDFLARE_ZONE_ID=

# ── Mail (E25: pluggable provider) ──
# MAIL_PROVIDER selects the transactional-email backend:
#   smtp     (default) — nodemailer; MailHog locally, any SMTP relay in prod
#   resend   — Resend HTTP API (requires RESEND_API_KEY)
#   sendgrid — SendGrid HTTP API (requires SENDGRID_API_KEY)
#   console  — logs only, never sends (safe dev/test fallback)
# A misconfigured provider degrades to console so dev/tests never crash.
MAIL_PROVIDER=smtp
# Default From header for outbound mail.
# MAIL_FROM=OB-CMS <no-reply@officebeacon.com>
# SMTP provider. MailHog dev defaults below (host localhost/mailhog, port 1025, no auth).
SMTP_HOST=localhost
SMTP_PORT=1025
# Prod SMTP relays (SES-SMTP / Mailgun-SMTP / Postmark-SMTP) — set auth + TLS:
# SMTP_USER=
# SMTP_PASS=
# MAIL_SMTP_SECURE=false   # set true for implicit TLS on port 465
# HTTP API providers — set MAIL_PROVIDER above to resend|sendgrid and the key:
# RESEND_API_KEY=
# SENDGRID_API_KEY=

# ── Governance / invitations ──
# Public base URL of the admin SPA — used to build the invite accept link
# (`${APP_PUBLIC_URL}/accept-invite?token=...`). Defaults to the admin dev port.
APP_PUBLIC_URL=http://localhost:5001

# ── Forms → CRM delivery pipeline (WAVE3b) ──
# Per-site config (site_settings.crm_*) overrides these globals. When unset, the
# worker defaults to the local mock-CRM receiver below so the loop is testable.
CRM_WEBHOOK_URL=http://localhost:3001/api/dev/mock-crm
CRM_HMAC_SECRET=dev-crm-secret
CRM_MOCK_SECRET=dev-crm-secret
# Legacy HubSpot URL for dual-write during cutover (optional).
CRM_LEGACY_URL=

# ── AI copilot — BYOK page generation (WAVE4a) ──
# At-rest encryption for tenant API keys (AES-256-GCM). Use a 64-hex-char value
# (32 bytes) in production; any string works in dev (SHA-256-normalized).
# KMS_DATA_KEY is an accepted fallback name for a future AWS KMS swap.
ENCRYPTION_KEY=dev-encryption-key-change-me-in-production
# Recommended/default provider: claude | openai | gemini.
AI_DEFAULT_PROVIDER=claude
# Offline mock provider — when true, generation runs with NO real key and emits a
# small valid hero+features+CTA layout (set AI_MOCK_BAD_FIRST=true to exercise the
# self-correction retry: one invalid layout, then a valid one).
AI_MOCK=false
AI_MOCK_BAD_FIRST=false
# Guardrails (per-tenant). Defaults are sane; override to tune cost ceilings.
AI_RATE_PER_MIN=10
AI_MONTHLY_TOKEN_CEILING=5000000
AI_MONTHLY_COST_CEILING_MICRO=50000000

# ── Admin SPA (Vite) ──
VITE_API_URL=http://localhost:3001
VITE_ORVAL_API_URL=http://localhost:3001
VITE_RENDERER_BASE_URL=http://localhost:3000
VITE_ENVIRONMENT=local

# VITE_PLATFORM_BASE_DOMAIN is [BUILD] only — Admin SPA platform base domain for
# per-tenant published URLs (https://<subdomain>.<base-domain>/<slug>). The app
# prepends the tenant/site subdomain; DevOps controls ONLY the base domain. This
# is the source of truth for the Published URL and takes priority over
# VITE_RENDERER_BASE_URL. There is NO hardcoded fallback: when blank, the Admin
# emits no platform-derived Published URL (it falls back to VITE_RENDERER_BASE_URL
# for local dev, else null). DevOps supplies the value at Admin build time in
# deployed environments; leave blank for local dev. Not used by the Renderer.
VITE_PLATFORM_BASE_DOMAIN=

# ── Renderer (Next.js) ──
# Renderer tenant routing uses the request Host header — do NOT set
# VITE_PLATFORM_BASE_DOMAIN here; it is Admin build-time only (see above).
RENDERER_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:3001

# Page-audit / Lighthouse public origin (local/dev fallback only).
# Production uses sites.primaryDomain / customDomain. Prefer the **renderer**
# (default :3000), not the admin SPA (:5001). Docker workers reaching a host
# renderer: AUDIT_BASE_URL=http://host.docker.internal:3000
# AUDIT_BASE_URL=http://localhost:3000
# Falls back to RENDERER_BASE_URL → RENDERER_INTERNAL_URL → http://localhost:3000
# RENDERER_BASE_URL=http://localhost:3000

# On-demand ISR revalidation: shared secret between the renderer's
# POST /api/revalidate (fail-closed: refuses all calls when unset) and the
# worker's cache-purge processor, which POSTs it after every publish so the
# published change is live immediately (not after the 60s ISR window).
REVALIDATE_SECRET=dev-revalidate-secret
# Where the WORKER reaches the renderer (container DNS in docker, localhost in dev).
RENDERER_INTERNAL_URL=http://localhost:3000

# ---- HubSpot connectors / import (api) ------------------------------------
# Portal allowlist for connect + import. Comma-separated list is preferred.
# When unset, local dev defaults to the OB sandbox portal id in block-schema.
# HUBSPOT_ALLOWED_PORTAL_IDS=
# HUBSPOT_ALLOWED_PORTAL_ID=

# Backups (E26): override the postgres client binaries if the host pg_dump
# version is older than the server. In prod the worker image should ship a
# matching postgresql-client; then these can stay as the bare commands.
PG_DUMP_BIN=pg_dump
PSQL_BIN=psql
