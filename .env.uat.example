# ==========================================================================
# OB-CMS — UAT environment template
# --------------------------------------------------------------------------
# Copy to `.env`, fill every <PLACEHOLDER>, then base64 it for the deploy
# workflow secret:   base64 -w0 .env   ->   GitHub secret ENV_FILE_BASE64
# The workflow writes this file to <SERVER_PATH>/.env; compose loads it via
# `env_file: ../.env`. NEVER commit the filled .env (secrets).
#
# Postgres / Redis / object storage are MANAGED external services in UAT.
# Generate secrets with:  openssl rand -hex 32
# Legend:  [MANAGED] external endpoint · [SECRET] generate · [MATCH] identical
#          across the noted services · [BUILD] baked at image build (also set
#          via workflow --build-arg; kept here for reference).
# ==========================================================================

# ---- Core (api + worker) -------------------------------------------------
ENVIRONMENT=staging                 # local | development | staging | production
GLOBAL_PREFIX=api/v1                # health lives at /api/v1/health
API_PORT=3001
RENDERER_PORT=3000
ADMIN_PORT=5001

# ---- Database — MANAGED Postgres 16 (api + worker) -----------------------
DATABASE_URL=postgresql://<user>:<pass>@<managed-pg-host>:5432/<db>   # [MANAGED]
DATABASE_SSL=true

# ---- Redis — MANAGED (api rate-limit/cache, worker BullMQ, renderer ISR) --
REDIS_HOST=<managed-redis-host>     # [MANAGED]
REDIS_PORT=6379
REDIS_PASSWORD=<redis-password>

# ---- Secrets -------------------------------------------------------------
JWT_SECRET=<openssl rand -hex 32>                 # [SECRET] api
ENCRYPTION_KEY=<openssl rand -hex 32>             # [SECRET][MATCH api+worker] 64 hex
REVALIDATE_SECRET=<openssl rand -hex 24>          # [SECRET][MATCH api+worker+renderer]

# ---- Auth / CORS / cookies (cross-subdomain) -----------------------------
ALLOWED_ORIGINS=https://uat-cms-admin.officebeacon.net,https://uat-cms.officebeacon.net
COOKIE_DOMAIN=.officebeacon.net     # leading dot → cookie shared across subdomains
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=7d
AUTH0_ENABLED=false
APP_PUBLIC_URL=https://uat-cms-admin.officebeacon.net   # invite/accept links

# ---- Object storage — MANAGED (S3 / R2 / MinIO) --------------------------
S3_ENDPOINT=<https://s3-endpoint>   # [MANAGED]
S3_REGION=<region>
S3_ACCESS_KEY=<key>
S3_SECRET_KEY=<secret>
S3_BUCKET=ob-cms-media-uat
# S3_PUBLIC_URL=<https://cdn-host>  # optional public media base

# ---- Mail ----------------------------------------------------------------
MAIL_PROVIDER=smtp                  # smtp | resend | sendgrid | console
SMTP_HOST=<smtp-host>
SMTP_PORT=587
SMTP_USER=<smtp-user>
SMTP_PASS=<smtp-pass>
# RESEND_API_KEY=<key>              # if MAIL_PROVIDER=resend
# SENDGRID_API_KEY=<key>            # if MAIL_PROVIDER=sendgrid

# ---- CRM delivery --------------------------------------------------------
CRM_WEBHOOK_URL=<crm-endpoint>
CRM_HMAC_SECRET=<secret>

# ---- Renderer (server-side) ----------------------------------------------
# NEXT_PUBLIC_API_URL is [BUILD] — baked by the workflow --build-arg; listed for reference.
NEXT_PUBLIC_API_URL=https://uat-cms-api.officebeacon.net
INTERNAL_API_URL=http://api:3001            # server-side fetch (compose service name)
RENDERER_INTERNAL_URL=http://renderer:3000  # api + worker → renderer (cache purge)
# RENDERER_ISR_REVALIDATE=60                 # optional ISR window (seconds)
# RENDERER_REDIS_CACHE=true                  # optional cache-layer toggle

# ---- Admin (static SPA) --------------------------------------------------
# VITE_API_URL is [BUILD] only — baked by the workflow --build-arg. Not read at runtime.
VITE_API_URL=https://uat-cms-api.officebeacon.net
# VITE_RENDERER_BASE_URL is [BUILD] only — optional local-dev/shared renderer origin.
# Used by the Admin ONLY as a fallback when VITE_PLATFORM_BASE_DOMAIN is unset. When
# VITE_PLATFORM_BASE_DOMAIN IS set (UAT/prod), the per-tenant subdomain URL
# (https://<subdomain>.<base-domain>) takes priority — see siteOriginUrl.
VITE_RENDERER_BASE_URL=
# VITE_PLATFORM_BASE_DOMAIN is [BUILD] only — Admin SPA platform base domain for
# per-tenant published URLs (https://<subdomain>.<base-domain>/<slug>). The app
# prepends the tenant/site subdomain; DevOps controls ONLY the base domain. This
# is the source of truth for the Published URL and takes priority over
# VITE_RENDERER_BASE_URL. There is NO hardcoded fallback: if blank, the Admin
# emits no platform-derived Published URL (then falls back to VITE_RENDERER_BASE_URL,
# else null). Required for UAT/prod tenant Published URLs — supplied at Admin build
# time only; not used by the Renderer. Leave blank in this template.
VITE_PLATFORM_BASE_DOMAIN=
# VITE_ENVIRONMENT is [BUILD] only — the environment label exposed to the Admin
# bundle via Vite. In staging, siteOriginUrl() fails closed (returns null)
# when no origin can be derived instead of generating synthetic tenant URLs.
VITE_ENVIRONMENT=staging

# ---- Rate limiting (defaults are sane; override if needed) ---------------
RATE_LIMIT_ENABLED=true

# ---- HubSpot connectors / import (api) — set explicit UAT portal ids ------
# HUBSPOT_ALLOWED_PORTAL_IDS=
# HUBSPOT_ALLOWED_PORTAL_ID=

# ---- AI copilot (BYOK; defaults fine) ------------------------------------
AI_DEFAULT_PROVIDER=claude
AI_MOCK=false

# ==========================================================================
# LOCAL-DEV-ONLY (compose "local" profile). Not used in UAT — managed hosts
# above replace these. Left here only so one .env can drive local compose too.
# POSTGRES_USER=obcms
# POSTGRES_PASSWORD=obcms
# POSTGRES_DB=obcms
# MINIO_ROOT_USER=minioadmin
# MINIO_ROOT_PASSWORD=minioadmin
# ==========================================================================
