# ─────────────────────────────────────────────────────────────────────────────
# OB-CMS — Production environment template
# ─────────────────────────────────────────────────────────────────────────────
#
# Hand this file to DevOps. Copy to the Production secret store / deployment
# manifest and populate every blank DevOps-owned value.
#
# Canonical reference: docs/infrastructure/environment-variables.md
# Deployment checklists: docs/infrastructure/deployment-checklist.md
#
# Production MUST use ENVIRONMENT=production. Boot validation rejects the default
# JWT_SECRET when ENVIRONMENT=production.
#
# Value labels used in this file:
#   Runtime default     — matches implementation when unset (.env.example, config loaders)
#   Recommended deployment value — suggested for Production; differs from runtime default
# ─────────────────────────────────────────────────────────────────────────────

# DevOps Required Values
# ──────────────────────
# Supply every variable listed below before Production goes live.
#
# Database
#   DATABASE_URL
#   DATABASE_PASSWORD          (only if not embedded in DATABASE_URL)
#
# Redis
#   REDIS_HOST
#   REDIS_PASSWORD               (when Redis AUTH is enabled)
#
# Authentication / JWT
#   JWT_SECRET                   (required — boot fails with default value)
#   PREVIEW_TOKEN_SECRET         (recommended)
#   AUTH0_DOMAIN                 (when AUTH0_ENABLED=true)
#   AUTH0_CLIENT_ID              (when AUTH0_ENABLED=true)
#   AUTH0_AUDIENCE               (when AUTH0_ENABLED=true)
#
# Encryption / AI BYOK
#   ENCRYPTION_KEY               (required for tenant BYOK key storage)
#
# Public URLs (deployment-specific)
#   ALLOWED_ORIGINS
#   APP_PUBLIC_URL
#   VITE_API_URL
#   NEXT_PUBLIC_API_URL
#   INTERNAL_API_URL
#   RENDERER_INTERNAL_URL
#   RENDERER_BASE_URL
#   AUDIT_BASE_URL
#   PLATFORM_DOMAIN
#   PLATFORM_BASE_DOMAIN
#   RENDERER_BASE_DOMAIN
#
# Object Storage (AWS S3)
#   OBJECT_STORAGE_REGION              (actual AWS region — not auto for native S3)
#   OBJECT_STORAGE_ACCESS_KEY_ID
#   OBJECT_STORAGE_SECRET_ACCESS_KEY
#   OBJECT_STORAGE_BUCKET          (DevOps-provisioned S3 bucket — app does not create it)
#   OBJECT_STORAGE_PUBLIC_MEDIA_URL  (CloudFront/CDN/public media URL)
#   Do NOT set OBJECT_STORAGE_ENDPOINT for native AWS S3.
#   Also remove stale legacy secrets from the Production secret store:
#     S3_ENDPOINT, S3_REGION (including S3_REGION=auto), S3_PUBLIC_URL
#   Blank values in this example do NOT delete existing deployment secrets.
#   OBJECT_STORAGE_PUBLIC_MEDIA_BUCKET          (isolated mode)
#   OBJECT_STORAGE_PRIVATE_FORM_ATTACHMENTS_BUCKET
#   OBJECT_STORAGE_PRIVATE_BACKUPS_BUCKET
#   S3_ACCESS_KEY
#   S3_SECRET_KEY
#   S3_PUBLIC_URL
#
# Cloudflare
#   CLOUDFLARE_ZONE_ID           (when edge capabilities enabled)
#
# Turnstile (form captcha — recommended for public forms)
#   TURNSTILE_SECRET_KEY
#   TURNSTILE_SITE_KEY
#
# Email
#   SMTP_HOST
#   SMTP_PORT                    (runtime default 1025; typical relay 587 or 465)
#   SMTP_USER
#   SMTP_PASS
#   RESEND_API_KEY               (when MAIL_PROVIDER=resend)
#   SENDGRID_API_KEY             (when MAIL_PROVIDER=sendgrid)
#   MAIL_FROM
#
# CRM delivery
#   CRM_WEBHOOK_URL
#   CRM_HMAC_SECRET
#
# Cache / ISR
#   REVALIDATE_SECRET
#
# Seed (first deploy only — rotate SUPER_ADMIN_PASSWORD immediately after)
#   SUPER_ADMIN_PASSWORD
#
# Optional integrations
#   VITE_UNSPLASH_ACCESS_KEY
#   CRM_LEGACY_URL
#   CHROME_PATH
# ─────────────────────────────────────────────────────────────────────────────

# ── Runtime ──────────────────────────────────────────────────────────────────
ENVIRONMENT=production
NODE_ENV=production

# ── API ──────────────────────────────────────────────────────────────────────
# API route prefix/version is defined in application code — see docs/api-versioning.md.
# Do not set GLOBAL_PREFIX in Production deployments.
API_PORT=3001
WORKER_PORT=3011
ALLOWED_ORIGINS=

# ── Database (Postgres 16) ───────────────────────────────────────────────────
DATABASE_URL=
# Recommended deployment value (runtime default: false)
DATABASE_SSL=true
DATABASE_HOST=
# Recommended deployment value (runtime default when DATABASE_URL unset: 5433 local Docker)
DATABASE_PORT=5432
DATABASE_USER=
DATABASE_PASSWORD=
DATABASE_NAME=

# ── Redis 7 (cache + BullMQ) ─────────────────────────────────────────────────
REDIS_HOST=
REDIS_PORT=6379
REDIS_PASSWORD=

# ── Auth ─────────────────────────────────────────────────────────────────────
JWT_SECRET=
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=7d
COOKIE_DOMAIN=
AUTH0_ENABLED=false
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_AUDIENCE=

# ── Rate limiting ──────────────────────────────────────────────────────────────
RATE_LIMIT_ENABLED=true
RATE_LIMIT_GLOBAL_WINDOW=60
RATE_LIMIT_GLOBAL_MAX=300
RATE_LIMIT_AUTH_WINDOW=60
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_FORM_WINDOW=60
RATE_LIMIT_FORM_MAX=10
RATE_LIMIT_AI_WINDOW=60
RATE_LIMIT_AI_MAX=5
RATE_LIMIT_AI_MONTHLY_MAX=500

# ── Object storage (AWS S3 — DevOps provisions bucket; app does not create it) ─
# Provider-neutral OBJECT_STORAGE_* takes precedence over legacy S3_*.
# See docs/architecture/platform-deployment.md
# Native AWS S3: set OBJECT_STORAGE_REGION to the actual AWS region (S3_REGION=auto is NOT valid).
# Omit OBJECT_STORAGE_ENDPOINT for native AWS S3.
# Migration cleanup: explicitly remove stale legacy secrets from the Production secret store —
#   S3_ENDPOINT, S3_REGION (including S3_REGION=auto), S3_PUBLIC_URL.
# Blank values in this example file do NOT delete existing deployment secrets.
OBJECT_STORAGE_PROVIDER=s3
OBJECT_STORAGE_MODE=shared
OBJECT_STORAGE_REGION=
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_SECRET_ACCESS_KEY=
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_PUBLIC_MEDIA_URL=
# Isolated mode only (requires OBJECT_STORAGE_MODE=isolated):
# OBJECT_STORAGE_PUBLIC_MEDIA_BUCKET=
# OBJECT_STORAGE_PRIVATE_FORM_ATTACHMENTS_BUCKET=
# OBJECT_STORAGE_PRIVATE_BACKUPS_BUCKET=
#
# Legacy S3 aliases (runtime still reads these when present; remove stale secrets — do not rely on blanks here):
S3_REGION=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=
S3_PUBLIC_URL=

# ── Edge / Cloudflare (config validation only until network adapters ship) ───
# Recommended deployment value (runtime default: none)
EDGE_PROVIDER=cloudflare
CLOUDFLARE_PURGE_ENABLED=false
CLOUDFLARE_CUSTOM_HOSTNAMES_ENABLED=false
CLOUDFLARE_ZONE_ID=

# ── Turnstile ────────────────────────────────────────────────────────────────
TURNSTILE_SECRET_KEY=
TURNSTILE_SITE_KEY=

# ── Mail ─────────────────────────────────────────────────────────────────────
MAIL_PROVIDER=smtp
MAIL_FROM=
SMTP_HOST=
# DevOps-owned. Runtime default: 1025 (MailHog). Common production relay: 587 or 465.
SMTP_PORT=
# Optional alias for SMTP_HOST (worker workflow emails):
# MAIL_HOST=
SMTP_USER=
SMTP_PASS=
MAIL_SMTP_SECURE=false
RESEND_API_KEY=
SENDGRID_API_KEY=

# ── Governance / invitations ─────────────────────────────────────────────────
APP_PUBLIC_URL=

# ── Forms → CRM delivery ─────────────────────────────────────────────────────
# CRM_MOCK_SECRET is for local development only — do NOT set in Production.
CRM_WEBHOOK_URL=
CRM_HMAC_SECRET=
CRM_LEGACY_URL=

# ── AI copilot ───────────────────────────────────────────────────────────────
# Optional alias for ENCRYPTION_KEY (accepted fallback name):
# KMS_DATA_KEY=
ENCRYPTION_KEY=
AI_DEFAULT_PROVIDER=claude
AI_MOCK=false
AI_MOCK_BAD_FIRST=false
AI_RATE_PER_MIN=10
AI_MONTHLY_TOKEN_CEILING=5000000
AI_MONTHLY_COST_CEILING_MICRO=50000000

# ── Admin SPA (build-time) ───────────────────────────────────────────────────
VITE_API_URL=
VITE_ORVAL_API_URL=
VITE_APP_PORT=5001
VITE_UNSPLASH_ACCESS_KEY=

# ── Renderer ─────────────────────────────────────────────────────────────────
RENDERER_PORT=3000
NEXT_PUBLIC_API_URL=
INTERNAL_API_URL=
RENDERER_INTERNAL_URL=
RENDERER_BASE_URL=
RENDERER_BASE_DOMAIN=
AUDIT_BASE_URL=
RENDERER_ISR_REVALIDATE=60
RENDERER_REDIRECT_TTL=30
RENDERER_REDIS_CACHE=true
REVALIDATE_SECRET=

# ── Platform domains ─────────────────────────────────────────────────────────
PLATFORM_DOMAIN=
PLATFORM_BASE_DOMAIN=

# ── Security tokens ──────────────────────────────────────────────────────────
PREVIEW_TOKEN_SECRET=

# ── Seed (first deploy only) ─────────────────────────────────────────────────
SUPER_ADMIN_EMAIL=admin@officebeacon.com
SUPER_ADMIN_PASSWORD=

# ── Worker — scheduled jobs ──────────────────────────────────────────────────
SSL_CHECK_CRON=0 4 * * *
PAGE_AUDIT_SCHEDULE_CRON=0 * * * *
RETENTION_PURGE_CRON=0 3 * * *
CONTENT_EXPIRY_CRON=* * * * *
SCHEDULED_PUBLISH_CRON=* * * * *
ANALYTICS_ROLLUP_CRON=0 * * * *
BACKUP_CRON=0 2 * * *

# ── Worker — processor tuning ────────────────────────────────────────────────
BACKUP_RETENTION_KEEP=7
BACKUP_RETENTION_DAYS=30
PG_DUMP_BIN=pg_dump
PSQL_BIN=psql
LINK_CHECK_MAX_PAGES=50
LINK_CHECK_MAX_LINKS=300
LINK_CHECK_CONCURRENCY=8
LINK_CHECK_TIMEOUT_MS=8000
PAGE_AUDIT_MAX_PAGES=50
PAGE_AUDIT_TIMEOUT_MS=60000
PAGE_AUDIT_STALE_MS=
SSL_CHECK_TIMEOUT_MS=8000
ANALYTICS_ROLLUP_LOOKBACK_HOURS=48
PROFILE_REBUILD_LOOKBACK_HOURS=720
RAW_EVENT_RETENTION_DAYS=400
CHROME_PATH=
