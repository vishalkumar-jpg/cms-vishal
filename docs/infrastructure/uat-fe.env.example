# OB-CMS — UAT frontend build-time env (Admin SPA + Renderer build)
# DevOps supplies UAT_FRONTEND_ENV_BASE64 and other deployment values externally.
# frontend-deploy.yml decodes that secret, then inject-uat-admin-env.sh overwrites
# VITE_API_URL, VITE_RENDERER_BASE_URL, and VITE_PLATFORM_BASE_DOMAIN before build.

# Runtime (renderer — MANDATORY for UAT indexing/crawl protection)
# Without ENVIRONMENT=staging on the renderer process, public UAT pages may be indexable.
ENVIRONMENT=staging

# ---- Admin SPA (Vite build-time — baked into the static bundle) ------------
VITE_API_URL=
VITE_ORVAL_API_URL=

# Renderer origin — optional local-dev/shared renderer origin. Used by the Admin
# ONLY as a fallback when VITE_PLATFORM_BASE_DOMAIN is unset. When
# VITE_PLATFORM_BASE_DOMAIN is set (UAT/prod), the per-tenant subdomain URL
# (https://<subdomain>.<base-domain>/<slug>) takes priority for "View published"
# URLs, so this shared origin is not used for the Published URL in that case.
# frontend-deploy.yml enforces this value before every Admin build.
VITE_RENDERER_BASE_URL=

# Platform base domain — Admin build-time ONLY. Required for tenant-specific
# Published URLs (https://<subdomain>.<value>/<slug>). Do NOT set on the Renderer.
# frontend-deploy.yml enforces this value before every Admin build.
VITE_PLATFORM_BASE_DOMAIN=
VITE_ENVIRONMENT=staging

# ---- Renderer (Next.js build-time) -----------------------------------------
NEXT_PUBLIC_API_URL=

# Auth0
# Populate from existing Office Beacon Auth0 tenant
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_AUDIENCE=

# Integrations
VITE_UNSPLASH_ACCESS_KEY=
