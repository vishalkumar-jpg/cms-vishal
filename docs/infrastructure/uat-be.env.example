# OB-CMS — UAT backend (API + worker)
# FE: https://uat-cms.officebeacon.net
# BE: https://uat-cms-api.officebeacon.net

# Application
ENVIRONMENT=staging
NODE_ENV=production
API_PORT=3001
WORKER_PORT=3011
ALLOWED_ORIGINS=https://uat-cms.officebeacon.net

# Database
DATABASE_URL=
DATABASE_SSL=true
DATABASE_HOST=
DATABASE_PORT=5432
DATABASE_USER=
DATABASE_PASSWORD=
DATABASE_NAME=uat-cms

# Redis
REDIS_HOST=
REDIS_PORT=6379
REDIS_PASSWORD=

# Authentication
JWT_SECRET=
COOKIE_DOMAIN=.officebeacon.net

# Auth0
# Populate from existing Office Beacon Auth0 tenant
AUTH0_ENABLED=false
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_AUDIENCE=

# Storage (AWS S3 — DevOps provisions bucket; omit OBJECT_STORAGE_ENDPOINT)
# Set OBJECT_STORAGE_REGION to the actual AWS region (S3_REGION=auto is NOT valid for native AWS S3).
# Migration cleanup: explicitly remove stale legacy secrets from the UAT deployment secret store —
#   S3_ENDPOINT, S3_REGION (including S3_REGION=auto), S3_PUBLIC_URL.
# Blank values in this example file do NOT delete existing UAT deployment secrets.
OBJECT_STORAGE_PROVIDER=s3
OBJECT_STORAGE_REGION=
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_SECRET_ACCESS_KEY=
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_PUBLIC_MEDIA_URL=
# Legacy S3 aliases (runtime still reads these when present; remove stale secrets — do not rely on blanks here):
S3_REGION=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=
S3_PUBLIC_URL=

# Security
ENCRYPTION_KEY=
REVALIDATE_SECRET=
PREVIEW_TOKEN_SECRET=

# Turnstile
TURNSTILE_SECRET_KEY=
TURNSTILE_SITE_KEY=

# Email
MAIL_PROVIDER=smtp
MAIL_FROM=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
MAIL_SMTP_SECURE=false
RESEND_API_KEY=
SENDGRID_API_KEY=

# CRM
CRM_WEBHOOK_URL=
CRM_HMAC_SECRET=
CRM_LEGACY_URL=

# URLs
APP_PUBLIC_URL=https://uat-cms.officebeacon.net
INTERNAL_API_URL=https://uat-cms-api.officebeacon.net

# Renderer
RENDERER_INTERNAL_URL=https://uat-cms.officebeacon.net
RENDERER_BASE_URL=https://uat-cms.officebeacon.net
RENDERER_BASE_DOMAIN=uat-cms.officebeacon.net

# Audit
AUDIT_BASE_URL=https://uat-cms.officebeacon.net
PAGE_AUDIT_TIMEOUT_MS=60000
PAGE_AUDIT_STALE_MS=300000

# Platform
PLATFORM_DOMAIN=uat-cms.officebeacon.net
PLATFORM_BASE_DOMAIN=officebeacon.net

# Admin bootstrap
SUPER_ADMIN_EMAIL=vivek.kachhadiya@officebeacon.com
SUPER_ADMIN_PASSWORD=

# Runtime
CHROME_PATH=/usr/bin/google-chrome
